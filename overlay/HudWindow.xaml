<?xml version="1.0" encoding="utf-8"?>
<!-- HUD visual tree, loaded at runtime with XamlReader (no BAML / no MSBuild).
     Two mutually exclusive roots share the window: a 132x40 pill (idle) and a
     320-wide card (collapsed 72 high, expanded up to 222 high for the first four
     tasks plus a "+N 个任务" summary). The window content itself is inset by 12 DIP
     so the DropShadowEffect has room; the code-behind animates Width/Height and
     grows the card upwards while the bottom edge stays put. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid.Resources>
        <!-- Dark context menu, no checkmark column. -->
        <Style x:Key="HudContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F71B1B1E" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="4"
                                MinWidth="128">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.5" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="16,7">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C34" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <!-- ============================ CARD (320 wide) ============================ -->
    <Grid x:Name="CardRoot" Width="320" Height="72"
          HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Visibility="Collapsed">
        <!-- background + soft black drop shadow -->
        <Border x:Name="CardShadowHost" CornerRadius="14" Background="#F21B1B1E">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
        </Border>
        <!-- subtle white hairline (hover target), state colour border sits on top -->
        <Border x:Name="CardBaseBorder" CornerRadius="14" BorderThickness="1"
                BorderBrush="#FFFFFF" Opacity="0.133" IsHitTestVisible="False" />
        <Border x:Name="CardStateBorder" CornerRadius="14" BorderThickness="1"
                BorderBrush="#F59E0B" Opacity="0" IsHitTestVisible="False" />

        <!-- Everything that must not paint outside the rounded card while the card is
             animating (expand/collapse) is clipped here. -->
        <Grid x:Name="CardClip" ClipToBounds="True">
            <!-- collapsed header: glyph + title + second line -->
            <Grid x:Name="CardHeader" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 16 DIP status glyph: filled dot / check / bang -->
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="CardDot" Width="10" Height="10" Fill="#9AA0A6"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="CardCheck" Text="&#x2713;" FontSize="15" FontWeight="Bold"
                               FontFamily="Segoe UI Symbol" Foreground="#34D399"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="CardBang" Text="!" FontSize="16" FontWeight="Bold"
                               FontFamily="Segoe UI Symbol" Foreground="#F87171"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <StackPanel x:Name="CardTextPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="CardTitle" Text="DSH" FontSize="15" FontWeight="SemiBold"
                               Foreground="#F9FAFB" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CardLine2" Text="执行中" FontSize="12"
                               Foreground="#A0A6AD" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- expanded body: first 4 task rows (42 DIP each) + optional "+N 个任务".
                 Rows are built in code; bottom-anchored so the card grows upwards while
                 the bottom padding stays fixed. -->
            <StackPanel x:Name="CardRows" VerticalAlignment="Bottom"
                        Margin="16,0,16,14" Visibility="Collapsed" />
        </Grid>

        <!-- top-right chrome: collapsed = task-count badge + chevron, expanded = chevron -->
        <Grid x:Name="CardChrome" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,13,12,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="TaskBadge" Height="16" CornerRadius="8" Background="#2E7AAAFF"
                        Padding="5,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TaskBadgeText" Text="3" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#7AAAFF" VerticalAlignment="Center" />
                </Border>
                <Grid x:Name="ExpandHit" Width="24" Height="24" Margin="4,0,0,0"
                      Background="Transparent" Cursor="Hand" ToolTip="展开全部任务">
                    <Path x:Name="ChevronPath" Width="16" Height="16" Stretch="None"
                          Stroke="#A0A6AD" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 3,6 L 8,11 L 13,6" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 2 px bottom shimmer (running only); clipped so the sweep stays inside -->
        <Grid x:Name="ShimmerClip" Height="2" VerticalAlignment="Bottom"
              Margin="14,0,14,9" ClipToBounds="True"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="ShimmerBar" Width="120" Height="2" HorizontalAlignment="Left"
                    CornerRadius="1" Opacity="0.85">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#007AAAFF" Offset="0" />
                        <GradientStop Color="#CC7AAAFF" Offset="0.5" />
                        <GradientStop Color="#007AAAFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShimmerTranslate" X="-130" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>

    <!-- ============================ PILL (132 x 40) ============================ -->
    <Grid x:Name="PillRoot" Width="132" Height="40"
          HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Cursor="Hand" ToolTip="点击回到 DSH">
        <Border x:Name="PillShadowHost" CornerRadius="20" Background="#E61B1B1E">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
        </Border>
        <Border x:Name="PillBaseBorder" CornerRadius="20" BorderThickness="1"
                BorderBrush="#FFFFFF" Opacity="0.094" IsHitTestVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <Ellipse Width="8" Height="8" Fill="#9AA0A6" VerticalAlignment="Center" />
            <TextBlock Text="DSH 空闲" FontSize="12.5" Foreground="#E6E8EC"
                       Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Grid>